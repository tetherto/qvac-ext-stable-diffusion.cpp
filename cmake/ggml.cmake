if(NOT TARGET ggml AND NOT TARGET ggml::ggml)
    if(SD_USE_SYSTEM_GGML)
        find_package(ggml CONFIG QUIET)
        if(NOT ggml_FOUND)
            message(FATAL_ERROR "System GGML was not found. Set ggml_DIR or use the qvac-ext-ggml vcpkg port with -DCMAKE_TOOLCHAIN_FILE=<vcpkg>/scripts/buildsystems/vcpkg.cmake.")
        endif()
    else()
        if(NOT EXISTS "${SD_GGML_SOURCE_DIR}/CMakeLists.txt")
            message(FATAL_ERROR "GGML source is unavailable. Run git submodule update --init ggml, set SD_GGML_SOURCE_DIR, or use -DSD_USE_SYSTEM_GGML=ON with the qvac-ext-ggml vcpkg toolchain.")
        endif()
        add_subdirectory("${SD_GGML_SOURCE_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/ggml")
    endif()
endif()
if(NOT TARGET ggml)
    add_library(ggml ALIAS ggml::ggml)
endif()

get_target_property(sd_ggml_public_includes ggml INTERFACE_INCLUDE_DIRECTORIES)
set(sd_ggml_public_include "")
foreach(directory IN LISTS sd_ggml_public_includes)
    string(REGEX REPLACE "^\\$<BUILD_INTERFACE:(.*)>$" "\\1" directory "${directory}")
    if(EXISTS "${directory}/ggml.h")
        set(sd_ggml_public_include "${directory}")
        break()
    endif()
endforeach()
if(NOT sd_ggml_public_include)
    message(FATAL_ERROR "The selected GGML target must export its public include directory containing ggml.h.")
endif()

if(SD_USE_UPSTREAM_GGML)
    target_compile_definitions(${SD_LIB} PUBLIC SD_USE_UPSTREAM_GGML)
    message(WARNING "Using upstream GGML: INT8 tensorwise/convrot is disabled and FP8 weights are converted to F16 at load time. Some operators may be unsupported and performance may be lower than with patched GGML.")
endif()

file(STRINGS "${sd_ggml_public_include}/ggml.h" sd_ggml_rope_flux_decl REGEX "ggml_rope_flux")
if(sd_ggml_rope_flux_decl)
    target_compile_definitions(${SD_LIB} PUBLIC SD_GGML_HAS_ROPE_FLUX=1)
endif()

# Probe the selected source headers; QVAC and Leejet carry different extensions.
function(sd_check_ggml_feature feature header symbol)
    file(STRINGS "${sd_ggml_public_include}/${header}" declaration REGEX "${symbol}")
    if(declaration)
        target_compile_definitions(${SD_LIB} PUBLIC ${feature}=1)
    endif()
endfunction()
sd_check_ggml_feature(SD_GGML_HAS_FP8 ggml.h GGML_TYPE_F8_E4M3)
sd_check_ggml_feature(SD_GGML_HAS_I8_TENSORWISE ggml.h ggml_mul_mat_i8_tensorwise)
sd_check_ggml_feature(SD_GGML_HAS_SAGE_ATTN ggml.h ggml_sage_attn)
sd_check_ggml_feature(SD_GGML_HAS_ROPE_APPLY ggml.h ggml_rope_apply)
sd_check_ggml_feature(SD_GGML_HAS_PREC_API ggml.h ggml_prec_set_acc)
sd_check_ggml_feature(SD_GGML_HAS_SCHED_COMPUTE_CALLBACK ggml-backend.h ggml_backend_sched_set_compute_callback)
